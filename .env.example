# Database (TiDB Cloud)
DATABASE_URL=mysql://user:password@host:4000/helpdesk?sslmode=VERIFY_IDENTITY

# Authentication
JWT_ACCESS_SECRET=your-64-char-secret-here
JWT_REFRESH_SECRET=your-64-char-secret-here

# Email (Brevo SMTP)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
