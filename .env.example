# TiDB Cloud Serverless connection string (Step 2).
# Format: mysql://USER:PASSWORD@HOST:4000/helpdesk
DATABASE_URL=mysql://helpdesk:YOUR_PASSWORD@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/helpdesk

# Auth (Step 3). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-random-64-char-string

# Seed credentials (optional - defaults live in src/db/seed.ts)
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_AGENT_EMAIL=agent@helpdesk.local
SEED_AGENT_PASSWORD=Agent1234!
SEED_CUSTOMER_EMAIL=customer@helpdesk.local
SEED_CUSTOMER_PASSWORD=Customer1234!