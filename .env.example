# TiDB Cloud Serverless connection string (Step 2).
# Format: mysql://USER:PASSWORD@HOST:4000/helpdesk
DATABASE_URL=mysql://helpdesk:YOUR_PASSWORD@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/helpdesk

# Auth (Step 3). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-char-random
JWT_REFRESH_SECRET=replace-with-random-64-char-string

# Seed credentials (optional - defaults live in src/db/seed.ts)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
MAIL_FROM=HelpDesk <noreply@yourdomain.com>
CRON_SECRET=replace-with-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000